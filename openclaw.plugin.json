{
  "id": "openclaw-onebot",
  "name": "OneBot Channel",
  "version": "1.3.0",
  "description": "OneBot v11 协议渠道插件（QQ / Lagrange.Core / go-cqhttp / NapCat，基于 WebSocket）",
  "author": "LSTM-Kirigaya",
  "channels": ["onebot"],
  "contracts": {
    "tools": [
      "onebot_send_text",
      "onebot_sticker_save",
      "onebot_sticker_send",
      "onebot_sticker_list",
      "onebot_send_image",
      "onebot_recall",
      "onebot_upload_file",
      "onebot_get_group_msg_history",
      "onebot_search_group_member",
      "onebot_run_script"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "onebot": {
      "label": "OneBot",
      "description": "通过 OneBot v11 WebSocket 接入 QQ（Lagrange.Core / go-cqhttp / NapCat）",
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["forward-websocket", "backward-websocket"],
            "description": "连接类型：forward-websocket（主动连接 OneBot）或 backward-websocket（OneBot 连接本机）"
          },
          "host": { "type": "string", "description": "OneBot 主机地址" },
          "port": { "type": "number", "description": "OneBot 端口" },
          "accessToken": { "type": "string", "description": "访问令牌（可选）" },
          "path": { "type": "string", "description": "WebSocket 路径，默认 /onebot/v11/ws" },
          "enabled": { "type": "boolean", "description": "是否启用该渠道" },
          "defaultAccount": { "type": "string", "description": "默认账号 id" },
          "accounts": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "type": { "type": "string", "enum": ["forward-websocket", "backward-websocket"] },
                "host": { "type": "string" },
                "port": { "type": "number" },
                "accessToken": { "type": "string" },
                "path": { "type": "string" },
                "enabled": { "type": "boolean" }
              }
            }
          },
          "requireMention": { "type": "boolean", "default": true, "description": "群聊是否需要 @ 机器人才回复" },
          "triggerKeywords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "当 requireMention 为 false 时生效的触发关键词"
          },
          "triggerMode": {
            "type": "string",
            "enum": ["prefix", "contains"],
            "description": "关键词匹配模式，默认 prefix"
          },
          "historyLimit": {
            "type": "number",
            "default": 20,
            "description": "触发回复时附带的群聊上下文条数（0 关闭；最多 100）"
          },
          "quoteEnabled": {
            "type": "boolean",
            "default": true,
            "description": "允许模型用 [[quote:消息ID]] 标记引用群里的某条消息"
          },
          "quoteChainDepth": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "default": 3,
            "description": "引用链向上追溯层数：消息 3 引用 2、2 引用 1 时，把整条链一次性带进上下文（0 = 只取直接引用的那一条）"
          },
          "quoteToBotReply": {
            "type": "boolean",
            "default": true,
            "description": "群友直接引用了机器人自己的发言时立即回复（等同 @，跳过智能触发判定）；显式 false 关闭"
          },
          "atEnabled": {
            "type": "boolean",
            "default": true,
            "description": "允许模型用 [[at:QQ号]] 在回复里 @ 群成员（也兼容 [CQ:at,qq=QQ号]）；空/非法 QQ 号会被剥除，不会把 CQ 码字面发到群里"
          },
          "stickerEnabled": {
            "type": "boolean",
            "default": true,
            "description": "在群聊上下文里附带本地表情包库摘要"
          },
          "stickerContextLimit": {
            "type": "number",
            "default": 8,
            "description": "上下文里展示的表情包条数（0 关闭；最多 30）"
          },
          "renderMarkdownToPlain": {
            "type": "boolean",
            "default": true,
            "description": "是否将回复中的 Markdown 渲染为纯文本再发送"
          },
          "collapseDoubleNewlines": {
            "type": "boolean",
            "default": true,
            "description": "是否将连续空行压缩为单个换行"
          },
          "normalModeFlushIntervalMs": {
            "type": "number",
            "default": 1200,
            "description": "normal 模式下聚合发送的等待窗口（毫秒）"
          },
          "normalModeFlushChars": {
            "type": "number",
            "default": 160,
            "description": "normal 模式下提前发送的字符阈值"
          },
          "longMessageMode": {
            "type": "string",
            "enum": ["normal", "og_image", "forward"],
            "default": "normal",
            "description": "长消息处理模式"
          },
          "longMessageThreshold": {
            "type": "number",
            "default": 300,
            "description": "长消息阈值（字符数）"
          },
          "ogImageRenderTheme": {
            "type": "string",
            "enum": ["default", "dust", "custom"],
            "default": "default",
            "description": "og_image 模式下的渲染主题"
          },
          "ogImageRenderThemePath": {
            "type": "string",
            "description": "ogImageRenderTheme 为 custom 时的 CSS 文件绝对路径"
          },
          "whitelistUserIds": {
            "type": "array",
            "items": { "type": "number" },
            "description": "白名单 QQ 号；非空时仅白名单内用户可触发 AI"
          },
          "blacklistUserIds": {
            "type": "array",
            "items": { "type": "number" },
            "description": "黑名单 QQ 号，在黑名单内的用户无法触发 AI"
          },
          "replyWhenWhitelistDenied": {
            "type": "boolean",
            "default": true,
            "description": "白名单外用户触发时是否回复“权限不足”"
          },
          "thinkingEmojiId": {
            "type": "number",
            "default": 60,
            "description": "Lagrange/QQ NT set_msg_emoji_like 表情 ID"
          },
          "onReplySessionEnd": {
            "type": "string",
            "description": "回复会话结束时的钩子脚本路径"
          },
          "groupIncrease": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "enabled": { "type": "boolean", "default": false },
              "message": { "type": "string" },
              "command": { "type": "string" },
              "cwd": { "type": "string" }
            }
          },
          "cronJobs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["name", "cron", "script", "groupIds"],
              "properties": {
                "name": { "type": "string" },
                "cron": { "type": "string" },
                "timezone": { "type": "string" },
                "script": { "type": "string" },
                "groupIds": { "type": "array", "items": { "type": "number" } }
              }
            }
          },
          "smartTrigger": {
            "type": "object",
            "additionalProperties": true,
            "default": {},
            "description": "智能触发（两段式）：关键词/别名直通；未命中时调用宿主 LLM 判断是否接话。默认关闭，必须显式设置 enabled=true 才生效",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false,
                "description": "总开关。必须显式配置为 true 才生效（requireMention=true 时也不会默认开启）"
              },
              "groups": {
                "type": "array",
                "items": { "type": "number" },
                "default": [],
                "description": "只对这些群号生效；空数组表示全部群生效"
              },
              "keywords": {
                "type": "array",
                "items": { "type": "string" },
                "default": [],
                "description": "直通关键词，命中即放行、不消耗 LLM；为空时继承 triggerKeywords"
              },
              "keywordMode": {
                "type": "string",
                "enum": ["prefix", "contains"],
                "default": "contains",
                "description": "关键词匹配模式：prefix（以关键词开头）或 contains（包含即命中）"
              },
              "aliases": {
                "type": "array",
                "items": { "type": "string" },
                "default": [],
                "description": "机器人别名（QQ 昵称等），消息中包含任一别名即直通放行"
              },
              "threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.6,
                "description": "LLM 判定置信度阈值（0~1），confidence ≥ threshold 才放行"
              },
              "timeoutMs": {
                "type": "number",
                "minimum": 1000,
                "maximum": 60000,
                "default": 8000,
                "description": "单次 LLM 判定超时（毫秒，1000~60000），超时按 fallback 处理"
              },
              "minIntervalMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 600000,
                "default": 3000,
                "description": "同群两次 LLM 判定的最小间隔（毫秒，0~600000）"
              },
              "cooldownMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600000,
                "default": 30000,
                "description": "同群放行回复后的冷却时间（毫秒，0~3600000）"
              },
              "maxRepliesPerHour": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "default": 6,
                "description": "同群每小时最多放行次数（0~100，0 表示不限）"
              },
              "historyLimit": {
                "type": "number",
                "minimum": 0,
                "maximum": 30,
                "default": 10,
                "description": "喂给判定模型的最近消息条数（0~30）"
              },
              "maxInputChars": {
                "type": "number",
                "minimum": 200,
                "maximum": 8000,
                "default": 2000,
                "description": "判定输入（历史 + 当前消息）的字符上限（200~8000），超出从最旧截断"
              },
              "model": {
                "type": "string",
                "default": "",
                "description": "可选，覆盖判定模型（如 deepseek/deepseek-flash）；空字符串表示使用宿主 agent 的默认模型。覆盖需宿主允许：plugins.entries.openclaw-onebot.llm.allowModelOverride=true"
              },
              "fallback": {
                "type": "string",
                "enum": ["ignore", "reply"],
                "default": "ignore",
                "description": "LLM 不可用 / 超时 / 解析失败时的策略：ignore（默认，忽略该消息）或 reply（放行回复）"
              },
              "minMessageChars": {
                "type": "number",
                "minimum": 0,
                "maximum": 200,
                "default": 2,
                "description": "过短消息（纯表情/符号）不做判定，直接忽略（0~200）"
              },
              "allowModelSilence": {
                "type": "boolean",
                "default": false,
                "description": "放行后允许模型在回复中输出 silentMarker 自主沉默（该消息不会发到群里）"
              },
              "silentMarker": {
                "type": "string",
                "default": "[[silent]]",
                "description": "沉默标记；模型只输出该标记时本轮不发送任何内容"
              },
              "sassEnabled": {
                "type": "boolean",
                "default": true,
                "description": "是否允许判定器在轻松场合选择吐槽式接话（intent=sass）：群友自嘲、吹牛立 flag、离谱翻车、抽象整活、玩梗求接梗等；关闭后只会认真回答"
              },
              "sassStyle": {
                "type": "string",
                "default": "",
                "description": "自定义吐槽风格提示（只对 intent=sass 的放行生效）；空字符串使用内置默认文案"
              },
              "judgePersona": {
                "type": "string",
                "default": "",
                "description": "判定器使用的人设摘要：告诉判定器「这是谁、别人怎么称呼它」，让它按人设判断该不该接话；空字符串使用内置默认（小鲸鱼）"
              }
            }
          },
          "pokeReply": {
            "type": "object",
            "additionalProperties": true,
            "default": {},
            "description": "戳一戳（拍一拍）回应：被戳的是机器人时，构造内部消息走 LLM 回复管线（带人设与群聊历史）。默认关闭",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false,
                "description": "总开关，需显式开启"
              },
              "cooldownMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 600000,
                "default": 10000,
                "description": "同群/同人冷却（毫秒），防连戳刷屏；0 表示不去重"
              },
              "pokeBack": {
                "type": "boolean",
                "default": false,
                "description": "是否先回戳一下（group_poke / friend_poke），回戳失败不影响 LLM 回应"
              },
              "prompt": {
                "type": "string",
                "default": "（戳了戳你）",
                "description": "注入给模型的场景文本，模型据此自然回应"
              }
            }
          }
        }
      },
      "uiHints": {
        "type": { "label": "连接类型" },
        "host": { "label": "主机地址", "placeholder": "127.0.0.1" },
        "port": { "label": "端口", "placeholder": "3001" },
        "accessToken": { "label": "Access Token", "sensitive": true },
        "path": { "label": "WebSocket 路径", "placeholder": "/onebot/v11/ws" },
        "requireMention": { "label": "群聊需 @ 回复" },
        "atEnabled": { "label": "允许回复中 @ 成员" },
        "quoteChainDepth": { "label": "引用链追溯层数" },
        "quoteToBotReply": { "label": "引用机器人时立即回复" },
        "renderMarkdownToPlain": { "label": "Markdown 转纯文本" },
        "normalModeFlushIntervalMs": { "label": "normal 聚合窗口(ms)" },
        "normalModeFlushChars": { "label": "normal 提前发送阈值" },
        "longMessageMode": { "label": "长消息处理模式" },
        "longMessageThreshold": { "label": "长消息阈值" },
        "ogImageRenderTheme": { "label": "OG 图片渲染主题" },
        "ogImageRenderThemePath": { "label": "自定义 CSS 路径" },
        "whitelistUserIds": { "label": "白名单 QQ 号" },
        "blacklistUserIds": { "label": "黑名单 QQ 号" },
        "replyWhenWhitelistDenied": { "label": "白名单外回复提示" },
        "thinkingEmojiId": { "label": "思考表情 ID" },
        "smartTrigger": { "label": "智能触发" },
        "smartTrigger.enabled": { "label": "启用智能触发" },
        "smartTrigger.groups": { "label": "生效群号（空=全部群）" },
        "smartTrigger.keywords": { "label": "直通关键词" },
        "smartTrigger.keywordMode": { "label": "关键词匹配模式" },
        "smartTrigger.aliases": { "label": "机器人别名" },
        "smartTrigger.threshold": { "label": "判定阈值" },
        "smartTrigger.timeoutMs": { "label": "判定超时(ms)" },
        "smartTrigger.minIntervalMs": { "label": "判定最小间隔(ms)" },
        "smartTrigger.cooldownMs": { "label": "回复冷却 ms" },
        "smartTrigger.maxRepliesPerHour": { "label": "每小时上限" },
        "smartTrigger.historyLimit": { "label": "判定上下文条数" },
        "smartTrigger.maxInputChars": { "label": "判定输入字符上限" },
        "smartTrigger.model": { "label": "判定模型（空=宿主默认）" },
        "smartTrigger.fallback": { "label": "LLM 失败策略" },
        "smartTrigger.minMessageChars": { "label": "最短消息长度" },
        "smartTrigger.allowModelSilence": { "label": "允许模型自主沉默" },
        "smartTrigger.silentMarker": { "label": "沉默标记" },
        "smartTrigger.sassEnabled": { "label": "允许吐槽式接话" },
        "smartTrigger.sassStyle": { "label": "吐槽风格提示" },
        "smartTrigger.judgePersona": { "label": "判定器人设摘要" },
        "pokeReply": { "label": "戳一戳回应" },
        "pokeReply.enabled": { "label": "启用戳一戳回应" },
        "pokeReply.cooldownMs": { "label": "戳一戳冷却 ms" },
        "pokeReply.pokeBack": { "label": "被戳时回戳" },
        "pokeReply.prompt": { "label": "戳一戳场景文本" }
      }
    }
  },
  "cliCommands": [
    {
      "name": "onebot",
      "description": "OneBot 渠道配置与工具",
      "hasSubcommands": true
    }
  ]
}
